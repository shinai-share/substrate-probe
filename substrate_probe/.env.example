# ポスト資本主義シミュレーション — 鍵の雛形
#
# 使い方: このファイルを同じ場所に .env として複製し、値を書き込む。
#         .env は .gitignore 済みであり、公開リポジトリには入らない。
#
# 既にシェルや CI で環境変数を設定している場合、そちらが優先される
# (.env は「無ければ補う」ものであって「決める」ものではない)。
#
# 鍵が無くても以下は動く:
#   python -m postcapitalism_sim.demo          三周を回す(LLM不要)
#   python -m postcapitalism_sim.concept_audit 主張と実装の乖離を実測
#   pytest tests/test_postcapitalism_*.py      全テスト
#
# 鍵が要るのは、批判者と分類器を別重み(GPT)で走らせるときだけである。
#   python -m postcapitalism_sim.compare_substrates

# 批判者・分類器に使う別重み基体の鍵。
OPENAI_API_KEY=

# 使うモデル名(省略時は gpt-5)。
# OPENAI_MODEL=gpt-5
